PORT=3000
NODE_ENV=production

# Cloudflare Pages의 정확한 origin (끝의 / 제외)
FRONTEND_ORIGIN=https://snu-ece-announcement.pages.dev
PUBLIC_SITE_URL=https://snu-ece-announcement.pages.dev

# 신청·학사 공지가 게시될 때 카카오톡 봇 중계 서버가 받을 JSON 웹훅
KAKAO_NOTICE_WEBHOOK_URL=https://your-bot.example.com/webhooks/notices

# Google OAuth 웹 애플리케이션: Render 서버에만 설정
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_REDIRECT_URI=https://snu-ece-announcement.onrender.com/api/auth/google/callback

# 자동 수집 전용 비밀 (관리자 로그인과 별개)
CRAWL_TRIGGER_SECRET=replace-with-at-least-32-random-characters

# Supabase 서버 전용 키. 프런트엔드에 노출 금지
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SUPABASE_NOTICES_TABLE=notices
SUPABASE_SETTINGS_TABLE=app_settings

# 서버에서만 사용
GEMINI_API_KEY=replace-with-gemini-api-key

# npx web-push generate-vapid-keys 로 생성
VAPID_PUBLIC_KEY=replace-with-vapid-public-key
VAPID_PRIVATE_KEY=replace-with-vapid-private-key
VAPID_SUBJECT=mailto:admin@example.com
