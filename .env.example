PORT=3000
NODE_ENV=production

# Cloudflare Pages의 정확한 origin (끝의 / 제외)
FRONTEND_ORIGIN=https://your-project.pages.dev
PUBLIC_SITE_URL=https://your-project.pages.dev

# 신청·학사 공지가 게시될 때 카카오톡 봇 중계 서버가 받을 JSON 웹훅
KAKAO_NOTICE_WEBHOOK_URL=https://your-bot.example.com/webhooks/notices

# 최소 32자 이상의 서로 다른 비밀값 사용
SUPER_ADMIN_TOKEN=replace-with-long-random-super-admin-token
NOTICE_ADMIN_TOKEN=replace-with-long-random-notice-admin-token
BANNER_ADMIN_PASSWORD=replace-with-long-random-banner-password
CRAWL_TRIGGER_SECRET=replace-with-at-least-32-random-characters

# Supabase 서버 전용 키. 프런트엔드에 노출 금지
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SUPABASE_NOTICES_TABLE=notices
SUPABASE_SETTINGS_TABLE=app_settings

# 서버에서만 사용
GEMINI_API_KEY=replace-with-gemini-api-key

# npx web-push generate-vapid-keys 로 생성
VAPID_PUBLIC_KEY=replace-with-vapid-public-key
VAPID_PRIVATE_KEY=replace-with-vapid-private-key
VAPID_SUBJECT=mailto:admin@example.com
