{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "snu-ece-crawl-trigger",
  "main": "crawl-worker.js",
  "compatibility_date": "2026-07-27",
  // cron으로만 도는 워커라 HTTP 진입점이 필요 없다. 공개 URL을 열어두지 않는다.
  "workers_dev": false,
  "preview_urls": false,
  "triggers": {
    "crons": ["*/30 * * * *"]
  },
  "vars": {
    "API_BASE_URL": "https://snu-ece-announcement.onrender.com"
  }
}
